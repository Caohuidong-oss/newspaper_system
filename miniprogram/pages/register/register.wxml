<view class="register-container">
  <view class="register-card">
    <!-- 紫色渐变头部 -->
    <view class="register-header">
      <view class="register-icon">📝</view>
      <view class="register-title">注册新账号</view>
      <view class="register-subtitle">创建后即可订阅报刊</view>
    </view>

    <!-- 表单区 -->
    <view class="register-body">
      <view class="form-group">
        <text class="form-label">用户名 <text class="required">*</text></text>
        <view class="input-group">
          <text class="input-icon">👤</text>
          <input class="form-input" placeholder="请输入用户名（至少 3 个字符）"
                 value="{{username}}" bindinput="onUsernameInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">密码 <text class="required">*</text></text>
        <view class="input-group">
          <text class="input-icon">🔒</text>
          <input class="form-input" password type="text" placeholder="请输入密码（至少 6 位）"
                 value="{{password}}" bindinput="onPasswordInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">确认密码 <text class="required">*</text></text>
        <view class="input-group">
          <text class="input-icon">🔐</text>
          <input class="form-input" password type="text" placeholder="再次输入密码"
                 value="{{confirmPassword}}" bindinput="onConfirmInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">真实姓名</text>
        <view class="input-group">
          <text class="input-icon">🧑</text>
          <input class="form-input" placeholder="选填，默认与用户名相同"
                 value="{{realName}}" bindinput="onRealNameInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">手机号</text>
        <view class="input-group">
          <text class="input-icon">📱</text>
          <input class="form-input" type="number" placeholder="选填"
                 value="{{phone}}" bindinput="onPhoneInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">收货地址</text>
        <view class="input-group">
          <text class="input-icon">📍</text>
          <input class="form-input" placeholder="选填"
                 value="{{address}}" bindinput="onAddressInput" />
        </view>
      </view>

      <button class="register-btn" bindtap="onRegister" loading="{{loading}}">✅ 注 册</button>

      <view class="register-tips">
        <text>已有账号？</text>
        <text class="link" bindtap="onBackToLogin">立即登录</text>
      </view>
    </view>
  </view>
</view>
