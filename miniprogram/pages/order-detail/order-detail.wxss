.detail-container {
  padding-bottom: 40rpx;
}

.status-card {
  text-align: center;
  padding: 40rpx 30rpx;
}

.status-badge {
  font-size: 28rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 16rpx;
}

.order-number {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.order-date {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
}

.item-price {
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 2rpx solid #f0f0f0;
}

.total-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #e74c3c;
}

.remark-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-bar {
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.btn-secondary {
  background: #e8e8e8;
  color: #666;
  border-radius: 40rpx;
  text-align: center;
  font-weight: 600;
  border: none;
}

.btn-secondary:active {
  opacity: .8;
}

.loading-text {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
