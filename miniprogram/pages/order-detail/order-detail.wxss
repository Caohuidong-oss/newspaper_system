.detail-container {
  padding-bottom: 60rpx;
}

.back-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 20rpx 0;
}
.back-icon {
  font-size: 40rpx;
  color: #667eea;
  font-weight: 300;
  line-height: 1;
}
.back-text {
  font-size: 26rpx;
  color: #667eea;
}
.back-bar:active { opacity: .6; }

.status-card {
  text-align: center;
  padding: 36rpx 30rpx;
  margin: 12rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.status-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 10rpx;
}

.status-badge {
  font-size: 32rpx !important;
  padding: 8rpx 36rpx !important;
  margin-bottom: 16rpx;
}

.order-number {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.order-date {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

.card {
  margin: 12rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.card-header {
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.info-row:last-child { border-bottom: none; }

.info-label {
  font-size: 26rpx;
  color: #999;
}
.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
}
.item-price {
  font-size: 26rpx;
  color: #e74c3c;
  font-weight: 700;
  min-width: 80rpx;
  text-align: right;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #f0f0f0;
}

.total-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.total-amount {
  font-size: 38rpx;
  font-weight: 700;
  color: #e74c3c;
}

.remark-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-bar {
  padding: 16rpx;
  display: flex;
  gap: 16rpx;
  flex-direction: column;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  text-align: center;
}

.btn-confirm {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}
.btn-confirm:active { opacity: .85; }

.btn-cancel {
  background: #f5f5f5;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
}
.btn-cancel:active { background: #fff5f5; }

.loading-text {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-text {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* ========== 状态小圆点 ========== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.badge-pending { background: #fff3cd; color: #856404; }
.badge-confirmed { background: #d4edda; color: #155724; }
.badge-cancelled { background: #f8d7da; color: #721c24; }
