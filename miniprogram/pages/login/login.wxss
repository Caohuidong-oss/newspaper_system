.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  padding: 60rpx 40rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  color: #333;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  text-align: center;
  color: #999;
  margin-bottom: 48rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.login-btn {
  width: 100%;
  margin-top: 24rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.register-hint {
  text-align: center;
  margin-top: 36rpx;
  font-size: 26rpx;
  color: #999;
}

.register-link {
  color: #667eea;
  margin-left: 6rpx;
}
