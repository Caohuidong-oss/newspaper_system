.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.login-card {
  width: 100%;
  max-width: 580rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,.2);
}

.login-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 50rpx 40rpx;
  text-align: center;
  color: #fff;
}

.login-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.login-title {
  font-size: 38rpx;
  font-weight: 700;
}

.login-subtitle {
  font-size: 24rpx;
  opacity: .8;
  margin-top: 8rpx;
}

.login-body {
  padding: 40rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 1rpx solid #e8ecf1;
  overflow: hidden;
}

.input-icon {
  padding: 0 16rpx;
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  height: 80rpx;
  background: transparent;
  padding: 0 20rpx 0 0;
  font-size: 28rpx;
  border: none;
  outline: none;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 16rpx;
  border: none;
  text-align: center;
}

.login-btn:active {
  opacity: .85;
}

.login-tips {
  text-align: center;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #667eea;
  font-weight: 600;
  margin-left: 4rpx;
}
