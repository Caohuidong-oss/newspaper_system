<view class="login-container">
  <view class="login-card">
    <!-- 紫色渐变的头部 -->
    <view class="login-header">
      <view class="login-icon">📰</view>
      <view class="login-title">报刊订阅系统</view>
      <view class="login-subtitle">登录以继续</view>
    </view>

    <!-- 表单区 -->
    <view class="login-body">
      <view class="form-group">
        <text class="form-label">用户名</text>
        <view class="input-group">
          <text class="input-icon">👤</text>
          <input class="form-input" placeholder="请输入用户名"
                 value="{{username}}" bindinput="onUsernameInput" />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">密码</text>
        <view class="input-group">
          <text class="input-icon">🔒</text>
          <input class="form-input" password type="text" placeholder="请输入密码"
                 value="{{password}}" bindinput="onPasswordInput" />
        </view>
      </view>

      <button class="login-btn" bindtap="onLogin" loading="{{loading}}">🔐 登 录</button>

      <view class="login-tips">
        <text>还没有账号？</text>
        <text class="link" bindtap="onRegister">立即注册 →</text>
      </view>
    </view>
  </view>
</view>
