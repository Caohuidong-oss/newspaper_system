.doc {
  padding: 40rpx 32rpx;
  line-height: 1.8;
  background: #fff;
  min-height: 100vh;
}

.h1 {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 40rpx;
  color: #333;
}

.h2 {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 28rpx;
  margin-bottom: 8rpx;
  color: #333;
}

.p {
  display: block;
  font-size: 28rpx;
  color: #555;
  text-indent: 2em;
}

.footer {
  display: block;
  text-align: center;
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #999;
}
