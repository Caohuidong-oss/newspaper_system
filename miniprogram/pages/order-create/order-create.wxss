.create-container {
  padding-bottom: 40rpx;
}

.user-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.picker-placeholder {
  color: #bbb;
}

.picker-arrow {
  color: #ccc;
}

.newspaper-list {
  margin-top: 10rpx;
}

.newspaper-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all .2s;
}

.newspaper-item:active {
  background: #f5f7fa;
}

.item-selected {
  border-color: #667eea;
  background: #f0f0ff;
}

.item-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.item-price {
  font-size: 22rpx;
  color: #e74c3c;
}

.qty-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f0f0;
  font-size: 32rpx;
  color: #666;
  font-weight: 700;
}

.stepper-btn:active {
  background: #ddd;
}

.stepper-value {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.total-card {
  margin: 0 20rpx;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.total-amount {
  font-size: 40rpx;
  font-weight: 700;
  color: #e74c3c;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.submit-bar {
  padding: 20rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.loading-text {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}
