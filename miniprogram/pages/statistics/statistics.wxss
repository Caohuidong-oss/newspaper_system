.stats-container {
  padding-bottom: 40rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
}

.stats-item {
  width: 50%;
  padding: 10rpx;
  box-sizing: border-box;
}

.rank-list {
  margin-top: 10rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #999;
  background: #f5f5f5;
  flex-shrink: 0;
}

.rank-top {
  color: #fff;
  background: #667eea;
}

.rank-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-count {
  font-size: 24rpx;
  color: #e74c3c;
  font-weight: 600;
  flex-shrink: 0;
}

.dist-list {
  margin-top: 10rpx;
}

.dist-item {
  margin-bottom: 24rpx;
}

.dist-item:last-child {
  margin-bottom: 0;
}

.dist-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dist-type {
  font-size: 26rpx;
  color: #333;
}

.dist-count {
  font-size: 24rpx;
  color: #999;
}

.dist-bar-bg {
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.dist-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 12rpx;
  transition: width .3s ease;
}

.loading-text, .empty-text {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
