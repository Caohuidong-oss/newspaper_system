.orders-container {
  padding-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 12rpx 16rpx;
  margin: 16rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #999;
  border-radius: 40rpx;
  font-weight: 600;
  transition: none;
}

.tab-active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.order-card {
  margin: 12rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-id {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-user {
  font-size: 26rpx;
  color: #555;
}

.order-date {
  font-size: 22rpx;
  color: #999;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
  flex-shrink: 0;
}

/* 状态小圆点 */
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
  vertical-align: middle;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-pending { background: #fff3cd; color: #856404; }
.badge-pending .status-dot { background: #ffc107; }
.badge-confirmed { background: #d4edda; color: #155724; }
.badge-confirmed .status-dot { background: #28a745; }
.badge-cancelled { background: #f8d7da; color: #721c24; }
.badge-cancelled .status-dot { background: #dc3545; }
.badge-admin { background: #dc3545; color: #fff; }
.badge-user { background: #0d6efd; color: #fff; }

.loading-text, .empty-text {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
