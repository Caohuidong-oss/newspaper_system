.orders-container {
  padding-bottom: 20rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 20rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #999;
  border-radius: 30rpx;
  font-weight: 600;
}

.tab-active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.order-card {
  margin: 12rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-id {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
}

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-user {
  font-size: 24rpx;
  color: #666;
}

.order-date {
  font-size: 22rpx;
  color: #999;
}

.order-footer {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
  display: flex;
  justify-content: flex-end;
}

.order-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
}

.loading-text, .empty-text {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
