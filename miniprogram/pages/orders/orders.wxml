<view class="orders-container">
  <!-- 状态标签 -->
  <view class="tabs">
    <view class="tab {{activeTab === index ? 'tab-active' : ''}}"
          wx:for="{{tabs}}" wx:key="key"
          data-index="{{index}}" bindtap="onTabTap">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>

  <!-- 空状态 -->
  <view wx:elif="{{orders.length === 0}}" class="empty-text">暂无订单</view>

  <!-- 订单列表 -->
  <view wx:else class="order-list">
    <view class="order-card card" wx:for="{{orders}}" wx:key="id"
          data-id="{{item.id}}" bindtap="goToDetail">
      <!-- 头部：编号 + 状态勋章 -->
      <view class="order-header">
        <text class="order-id">#{{item.id}}</text>
        <text class="badge {{item.statusClass}}">
          <text class="status-dot {{item.statusClass}}"></text>
          {{item.statusText}}
        </text>
      </view>
      <!-- 主体：订户 + 日期 + 金额 -->
      <view class="order-body">
        <view class="order-info">
          <text class="order-user">👤 {{item.user_name || '未知'}}</text>
          <text class="order-date">{{item.dateShort}}</text>
        </view>
        <text class="order-amount">¥{{item.totalAmount}}</text>
      </view>
    </view>
  </view>
</view>
