.profile-container {
  padding-bottom: 40rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-meta {
  flex: 1;
}

.profile-username {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.profile-role {
  font-size: 20rpx;
}

.edit-btn {
  padding: 12rpx 28rpx;
  border: 2rpx solid #667eea;
  color: #667eea;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: transparent;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.info-input {
  flex: 1;
  height: 56rpx;
  font-size: 26rpx;
  color: #333;
}

.save-btn {
  width: 100%;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.logout-bar {
  margin: 40rpx 20rpx 0;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.logout-btn:active {
  background: #fff5f5;
}
