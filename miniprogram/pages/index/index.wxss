.index-container {
  padding-bottom: 20rpx;
}

/* ========== 欢迎横幅 ========== */
.welcome-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 32rpx 28rpx;
  color: #fff;
  margin: 20rpx 20rpx 0;
  border-radius: 16rpx;
}

.welcome-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.welcome-label {
  font-size: 26rpx;
  opacity: .8;
}

.welcome-username {
  font-size: 32rpx;
  font-weight: 700;
}

.welcome-role {
  font-size: 22rpx !important;
  margin-left: 8rpx;
}

.welcome-desc {
  font-size: 24rpx;
  opacity: .85;
  display: block;
  margin: 8rpx 0 20rpx;
}

.welcome-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.welcome-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: inline-block;
}
.welcome-btn.primary {
  background: #fff;
  color: #667eea;
}
.welcome-btn.outline {
  border: 2rpx solid #fff;
  color: #fff;
}
.welcome-btn:active { opacity: .8; }

/* ========== 统计卡片 ========== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 12rpx;
}

.stats-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

.stat-card {
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  color: #fff;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.stat-icon {
  position: absolute;
  right: -10rpx;
  bottom: -10rpx;
  font-size: 110rpx;
  opacity: .15;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  position: relative;
}

.stat-label {
  font-size: 24rpx;
  opacity: .85;
  margin-top: 8rpx;
  position: relative;
}

/* ========== 卡片通用 ========== */
.flex-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  font-weight: 700;
  font-size: 30rpx;
}

.card-link {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
}
.card-link:active { opacity: .6; }

/* ========== 订单列表 ========== */
.order-list {
  margin-top: 8rpx;
}

.order-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-row:last-child {
  border-bottom: none;
}

.order-icon {
  width: 60rpx;
  height: 60rpx;
  background: #f5f7fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.order-id {
  font-size: 28rpx;
  color: #333;
  font-weight: 700;
}

.order-line2 {
  font-size: 22rpx;
  color: #999;
}

.order-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
  flex-shrink: 0;
}

/* ========== 状态 dot ========== */
.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
}

/* ========== 热门报刊 ========== */
.top-paper-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
}

.top-paper-row:last-child {
  border-bottom: none;
}

.top-paper-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.top-paper-qty {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

/* ========== 快捷操作 ========== */
.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-btn {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid;
}
.quick-btn.primary {
  color: #667eea;
  border-color: #667eea;
  background: #f5f7ff;
}
.quick-btn.info {
  color: #17a2b8;
  border-color: #17a2b8;
  background: #e0f7fa;
}
.quick-btn.danger {
  color: #dc3545;
  border-color: #dc3545;
  background: #fff5f5;
}
.quick-btn.warning {
  color: #ffc107;
  border-color: #ffc107;
  background: #fff8e1;
}
.quick-btn:active { opacity: .7; }

.loading-text, .empty-text {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
