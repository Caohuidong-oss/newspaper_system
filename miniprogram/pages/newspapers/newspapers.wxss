.newspapers-container {
  padding-bottom: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 0;
}

.search-input {
  flex: 1;
  height: 68rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.search-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 12rpx;
  padding: 0 30rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  border: none;
}

.search-btn:active {
  opacity: .85;
}

.newspapers-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.newspaper-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 0;
  overflow: hidden;
}

.newspaper-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.newspaper-info {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.newspaper-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.newspaper-type {
  align-self: flex-start;
}

.newspaper-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #e74c3c;
  margin-top: 4rpx;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.loading-text, .empty-text {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
