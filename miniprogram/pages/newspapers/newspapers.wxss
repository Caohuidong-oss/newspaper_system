.newspapers-container {
  padding-bottom: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 26rpx;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
}

.search-btn:active {
  opacity: .85;
}

.newspapers-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.newspaper-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.newspaper-image {
  width: 100%;
  height: 240rpx;
  display: block;
}

.newspaper-info {
  padding: 20rpx;
}

.newspaper-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.newspaper-type {
  font-size: 20rpx;
  margin-bottom: 12rpx;
}

.newspaper-price {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
}

.price-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
}

.loading-text, .empty-text {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
