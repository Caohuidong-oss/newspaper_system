.newspapers-container {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.search-input {
  flex: 1;
  height: 56rpx;
  font-size: 26rpx;
}

.search-btn {
  padding: 12rpx 28rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  flex-shrink: 0;
}
.search-btn:active { opacity: .85; }

.add-btn {
  background: linear-gradient(135deg, #11998e, #38ef7d);
}

/* 下架标签 */
.off-shelf-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(220,53,69,.9);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* 管理员操作按钮 */
.admin-actions {
  margin-top: 10rpx;
  text-align: right;
}

.manage-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #667eea;
  padding: 6rpx 16rpx;
  border: 1rpx solid #667eea;
  border-radius: 24rpx;
}

/* 报刊网格 */
.newspapers-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
}

.newspaper-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,.06);
}

.image-wrap {
  position: relative;
  width: 100%;
  height: 220rpx;
}

.newspaper-image {
  width: 100%;
  height: 220rpx;
  display: block;
}

.image-placeholder {
  width: 100%;
  height: 220rpx;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.newspaper-info {
  padding: 16rpx;
}

.newspaper-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.newspaper-type {
  font-size: 20rpx !important;
  display: inline-block;
  margin-bottom: 8rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.badge-pending { background: #e8f4fd; color: #0d6efd; }
.badge-confirmed { background: #d4edda; color: #155724; }
.badge-cancelled { background: #f8d7da; color: #721c24; }
.badge-admin { background: #dc3545; color: #fff; }
.badge-user { background: #0d6efd; color: #fff; }

.price-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

.newspaper-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #e74c3c;
}

.price-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
}

/* ========== 空 / 加载 ========== */
.loading-text, .empty-text {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
